# ==============================================================================
# Cloud RISC-V Visual Simulator & Waveform Studio — .gitignore
# ==============================================================================

# OS & Desktop Metadata
.DS_Store
.DS_Thumbs.db
Thumbs.db
desktop.ini

# Editor & IDE Directories
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp

# Python Environments & Bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secret Configurations
.env
.env.local
.env.*.local

# Simulation Executables & Build Objects
*_sim
*.o
*.so
*.dll
*.dylib
obj_dir/
verilated*
Vriscv_sim_top

# Simulation Artifacts, Outputs, & Logs
hardware/sim/*.hex

# Keep the default simulator regression program
!hardware/sim/program.hex

# Waveform Traces (Ignore all generated VCDs except committed verification benchmarks)
*.vcd
hardware/sim/*.vcd
backend/*.vcd
artifacts/waveforms/**/*.vcd

# Explicitly retain benchmark waveforms for verification evidence:
!verification/reports/waveforms/*.vcd

# AI/Tooling Scratch Dirs
.kilo/
# Runtime logs
*.log
*.err
artifacts/simulation/logs/

# Preserve intentional verification waveforms
!verification/reports/waveforms/
!verification/reports/waveforms/*.vcd
